import numpy as np
import os
import argparse
import tifffile
from typing import Tuple, Dict, Any, List

# --- IMPORTS FROM diet4cola.generation PACKAGE ---
# These imports assume you have run 'pip install -e .' in your project root
# to make the diet4cola package available.
from diet4cola.generation.cola import CoLACut
from diet4cola.generation.masks import cell_mask, cut_mask
from diet4cola.generation.noise import myosin_noise, actin_noise
from diet4cola.generation.operations import add, mul, normalize, blur

# --- FIXED PARAMETERS (Based on artificial_cola.ipynb) ---
IMG_W, IMG_H = 512, 512
CELL_EXTENT = (200, 200)
CELL_MASK_SIGMA = 50.0
ACTIN_NOISE_POINTS = 2560
MYOSIN_OFFSET = -0.05
MYOSIN_ITERATIONS = 10
CUT_OFFSET_BOUND = 32
CUT_MAX_LENGTH = 150

# ----------------------------------------------------------------------
# Core Generation Logic 
# ----------------------------------------------------------------------

def _generate_cell_layer(width: int, height: int, center: Tuple[int, int], seed: int) -> Tuple[np.ndarray, Tuple[int, int], float]:
    """Generates the base cell mask."""
    return cell_mask(width, height, center, CELL_EXTENT, CELL_MASK_SIGMA, seed)

def _generate_actomyosin_cortex(width: int, height: int, cell_mask_layer: np.ndarray, seed: int) -> np.ndarray:
    """Generates the cytoskeleton texture (noise)."""
    myosin_layer = myosin_noise(width, height, seed=seed, iterations=MYOSIN_ITERATIONS)
    myosin_layer = mul(myosin_layer, cell_mask_layer)

    actin_layer = actin_noise(width, height, cell_mask_layer, ACTIN_NOISE_POINTS, MYOSIN_OFFSET, seed)
    actin_layer = mul(actin_layer, cell_mask_layer)

    actomyosin_layer = add(myosin_layer, actin_layer)
    return normalize(actomyosin_layer)

def _generate_cola_cut_mask(width: int, height: int, cola_cut: CoLACut) -> np.ndarray:
    """Creates a thin, blurred elliptical mask for the cut."""
    cut_length = cola_cut.cut_length
    cut_thickness = max(2, int(0.02 * cut_length)) # Min 2px thickness
    angle_deg_cut = np.rad2deg(cola_cut.cut_alpha) + 90 # Adjust angle for ellipse rotation

    cut_mask_img = cut_mask(
        width, height, 
        offset=cola_cut.cut_center, 
        extent=(cut_length // 2, cut_thickness // 2), 
        angle=angle_deg_cut
    )
    cut_mask_img = blur(cut_mask_img, kernel=(5, 5), sigma=1.0) 
    return normalize(cut_mask_img)

def _apply_cut(actomyosin_layer: np.ndarray, cut_mask_img: np.ndarray) -> np.ndarray:
    """Applies the cut by multiplying the texture by an attenuated, inverted cut mask."""
    cut_effect = mul(cut_mask_img, 0.9) # 90% darkening
    final_cell_image = mul(actomyosin_layer, (1 - cut_effect))
    return normalize(final_cell_image)


def generate_single_cell_data(
    idx: int,
    width: int, 
    height: int, 
    base_seed: int
) -> Dict[str, Any]:
    """Orchestrates the generation of one cell and its ground truth data."""
    
    seed = base_seed + idx * 10
    np.random.seed(seed)
    
    # Calculate initial center with a slight random offset
    center_offset = np.random.randint(CUT_OFFSET_BOUND) - CUT_OFFSET_BOUND // 2
    current_center = (width // 2 + center_offset, height // 2 + center_offset)

    # Use unique seeds for each component to ensure variation
    cell_mask_layer, _, _ = _generate_cell_layer(width, height, current_center, seed + 1)
    actomyosin_layer = _generate_actomyosin_cortex(width, height, cell_mask_layer, seed + 2)
    cola_cut = CoLACut(current_center, CUT_OFFSET_BOUND, CUT_MAX_LENGTH, seed + 3)
    cut_mask_img = _generate_cola_cut_mask(width, height, cola_cut)

    final_image = _apply_cut(actomyosin_layer, cut_mask_img)

    # Collect ground truth parameters
    return {
        "image": final_image,
        "mask": cell_mask_layer,
        "cut_mask": cut_mask_img,
        "cell_center": current_center,
        "cut_center": cola_cut.cut_center,
        "cut_length": cola_cut.cut_length,
        "cut_angle_rad": cola_cut.cut_alpha,
        "cut_origin": cola_cut.cut_origin,
        "cut_destination": cola_cut.cut_destination,
    }

def save_cell_data(data: Dict[str, Any], save_dir: str, name: str):
    """Saves the cell image, masks (TIF) and parameters (NPY)."""
    file_path = os.path.join(save_dir, name)
    
    # Save image and masks as 8-bit TIF files
    tifffile.imwrite(f"{file_path}_image.tif", (data["image"] * 255).astype(np.uint8))
    tifffile.imwrite(f"{file_path}_mask.tif", (data["mask"] * 255).astype(np.uint8))
    tifffile.imwrite(f"{file_path}_cut_mask.tif", (data["cut_mask"] * 255).astype(np.uint8))

    # Save parameters as a NumPy dictionary for ground truth
    params = {k: v for k, v in data.items() if k not in ["image", "mask", "cut_mask"]}
    np.save(f"{file_path}_params.npy", params)

def load_cell_params(load_dir: str, name: str) -> Dict[str, Any]:
    """Loads the ground truth parameters for a cell."""
    file_path = os.path.join(load_dir, f"{name}_params.npy")
    return np.load(file_path, allow_pickle=True).item()

def generate_and_save_dataset(n_cells: int, dataset_name: str, base_seed: int):
    """Main function to generate N cells and save the dataset."""
    save_dir = os.path.join("data", dataset_name)
    os.makedirs(save_dir, exist_ok=True)
    print(f"Directory created: {save_dir}")

    for i in range(n_cells):
        cell_data = generate_single_cell_data(idx=i, width=IMG_W, height=IMG_H, base_seed=base_seed)
        cell_name = f"cell_{i:04d}"
        save_cell_data(cell_data, save_dir, cell_name)
        
    print(f"Generation of {n_cells} cells completed and saved to {save_dir}.")

# ----------------------------------------------------------------------

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description="Synthetic CoLA Dataset Generator.")
    parser.add_argument('-n', '--num_cells', type=int, default=10, help='Number of cells to generate (N).')
    parser.add_argument('-d', '--dataset_name', type=str, default='cola_dataset', help='Subfolder name in data/ to save files.')
    parser.add_argument('--seed', type=int, default=100, help='Base seed for dataset reproducibility.')
    
    args = parser.parse_args()
    
    generate_and_save_dataset(
        n_cells=args.num_cells,
        dataset_name=args.dataset_name,
        base_seed=args.seed
    )

    # Example of loading the saved parameters
    if args.num_cells > 0:
        dataset_path = os.path.join("data", args.dataset_name)
        first_cell_params = load_cell_params(dataset_path, "cell_0000")
        print("\n--- Example of Loaded Parameters (Ground Truth) ---")
        for k, v in first_cell_params.items():
            print(f"{k}: {v}")